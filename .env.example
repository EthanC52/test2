ETHERSCAN_API_KEY=replace_me
SOLSCAN_API_KEY=replace_me

# Optional endpoints. Defaults point to public mainnet services.
XRPL_RPC_URL=https://xrplcluster.com/
STELLAR_HORIZON_URL=https://horizon.stellar.org

# Optional Etherscan Free-tier guards.
ETHERSCAN_MIN_INTERVAL_SECONDS=0.36
ETHERSCAN_MAX_TRANSFER_PAGES=10000
ETHERSCAN_CONFIRMATIONS=12

# Usually set automatically by scripts/fetch.py. The workflow commits this internal
# checkpoint so 30-minute runs only scan new Ethereum transfers.
# ETHERSCAN_STATE_DIR=.state/etherscan
